generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String              @id @default(uuid())
  email               String              @unique
  passwordHash        String
  name                String
  designation         String
  department          String
  activeRole          String              @default("EMPLOYEE")
  avatarUrl           String?
  phone               String?             @default("")
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  activityEvents      ActivityEvent[]
  approvedChanges     ChangeRequest[]     @relation("ChangeApprover")
  createdClients      Client[]
  createdDiscussions  ClientDiscussion[]
  clientUpdates       ClientUpdate[]
  docVersions         DocumentVersion[]
  employeeProfile     Employee?
  createdLeads        Lead[]              @relation("CreatedBySalesperson")
  assignedLeads       Lead[]              @relation("AssignedSalesperson")
  leadFollowups       LeadFollowup[]
  notifications       Notification[]
  createdProjects     Project[]           @relation("ProjectCreator")
  completedChecklists ProjectChecklist[]  @relation("ChecklistCompleter")
  assignedChecklists  ProjectChecklist[]  @relation("ChecklistAssignee")
  updatedDocs         ProjectDocument[]   @relation("DocUpdater")
  createdDocs         ProjectDocument[]   @relation("DocCreator")
  removedMemberships  ProjectMembership[] @relation("MembershipRemover")
  assignedMemberships ProjectMembership[] @relation("MembershipAssigner")
  projectNotes        ProjectNote[]
  createdTasks        Task[]              @relation("TaskCreator")
  assignedTasks       Task[]              @relation("TaskAssignee")
  userRoles           UserRole[]
  termsAcceptedVersion String?
  termsAcceptedAt      DateTime?
  reviewedTimeModifications TimeModificationRequest[] @relation("TimeModificationReviewer")
  termsPublished       Terms[]             @relation("TermsPublisher")
  termsAcceptances     TermsAcceptanceLog[]
  approvedLeaves      LeaveRequest[]      @relation("LeaveApprover")
  pushTokens          UserPushToken[]
  uploadedMedia       MediaFile[]         @relation("UserUploadedMedia")
  chatParticipants    ConversationParticipant[]
  chatMessages        ChatMessage[]
  salesNotes          SalesNote[]
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  code            String           @unique
  description     String?
  rolePermissions RolePermission[]
  userRoles       UserRole[]
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique
  domain          String
  description     String?
  rolePermissions RolePermission[]
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Lead {
  id                    String         @id @default(uuid())
  leadNumber            String         @unique
  contactPerson         String
  companyName           String?
  mobile                String
  whatsapp              String?
  email                 String?
  source                String         @default("WEBSITE")
  interestedService     String
  description           String?
  industry              String?
  subCategory           String?
  businessType          String?
  location              String?
  goalsJson             String?        @default("[]")
  servicesJson          String?        @default("[]")
  durationType          String?
  durationMonths        Int?
  targetAudience        String?
  competitors           String?
  additionalDetails     String?
  estimatedBudget       Float          @default(0)
  expectedValue         Float          @default(0)
  priority              String         @default("MEDIUM")
  status                String         @default("NEW")
  assignedSalespersonId String?
  nextFollowupAt        DateTime?
  remarks               String?
  lostReason            String?
  createdById           String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  createdBy             User?          @relation("CreatedBySalesperson", fields: [createdById], references: [id])
  assignedSalesperson   User?          @relation("AssignedSalesperson", fields: [assignedSalespersonId], references: [id])
  activities            LeadActivity[]
  followups             LeadFollowup[]
  mediaFiles            MediaFile[]    @relation("LeadMediaFiles")

  @@index([assignedSalespersonId])
  @@index([status])
  @@index([email])
  @@index([mobile])
}

model LeadFollowup {
  id                String    @id @default(uuid())
  leadId            String
  salespersonId     String
  scheduledAt       DateTime
  communicationType String    @default("CALL")
  notes             String?
  result            String?
  nextAction        String?
  nextFollowupAt    DateTime?
  status            String    @default("PENDING")
  createdAt         DateTime  @default(now())
  salesperson       User      @relation(fields: [salespersonId], references: [id])
  lead              Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model LeadActivity {
  id          String   @id @default(uuid())
  leadId      String
  actorId     String
  action      String
  detailsJson String?
  createdAt   DateTime @default(now())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Client {
  id                 String              @id @default(uuid())
  clientNumber       String              @unique
  companyName        String
  billingAddress     String?
  taxId              String?
  gstNumber          String?
  phone              String
  email              String
  notes              String?
  totalBusiness      Float               @default(0)
  outstandingBalance Float               @default(0)
  createdById        String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdBy          User                @relation(fields: [createdById], references: [id])
  contacts           ClientContact[]
  portalTokens       ClientPortalToken[]
  invoices           Invoice[]
  projects           Project[]
  personalBrandProfiles PersonalBrandProfile[]
  eventProjects      EventProject[]

  @@index([createdById])
}

model ClientContact {
  id              String             @id @default(uuid())
  clientId        String
  name            String
  designation     String
  email           String?
  phone           String?
  isPrimary       Boolean            @default(false)
  termsAccepted   Boolean            @default(false)
  termsAcceptedAt DateTime?
  termsVersion    String?            @default("v1.0")
  createdAt       DateTime           @default(now())
  client          Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  discussions     ClientDiscussion[]
  termsAcceptances TermsAcceptanceLog[]
}

model ProjectType {
  id                  String    @id @default(uuid())
  name                String    @unique
  code                String    @unique
  description         String?
  defaultWorkflowJson String?
  projects            Project[]
}

model Project {
  id                   String              @id @default(uuid())
  projectNumber        String              @unique
  name                 String
  clientId             String
  projectTypeId        String?
  description          String?
  scopeText            String?
  contractValue        Float               @default(0)
  startDate            DateTime?
  targetDeadline       DateTime?
  actualCompletionDate DateTime?
  status               String              @default("DRAFT")
  priority             String              @default("MEDIUM")
  progressPercentage   Float               @default(0)
  liveUrl              String?
  stagingUrl           String?
  designUrl            String?
  createdById          String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  changeRequests       ChangeRequest[]
  discussions          ClientDiscussion[]
  portalTokens         ClientPortalToken[]
  clientUpdates        ClientUpdate[]
  invoices             Invoice[]
  paymentMilestones    PaymentMilestone[]
  createdBy            User                @relation("ProjectCreator", fields: [createdById], references: [id])
  projectType          ProjectType?        @relation(fields: [projectTypeId], references: [id])
  client               Client              @relation(fields: [clientId], references: [id])
  documents            ProjectDocument[]
  memberships          ProjectMembership[]
  notes                ProjectNote[]
  stages               ProjectStage[]
  tasks                Task[]
  workSessions         WorkSession[]
  chatConversations    Conversation[]

  @@index([clientId])
  @@index([status])
}

model ProjectMembership {
  id            String    @id @default(uuid())
  projectId     String
  employeeId    String
  roleInProject String    @default("MEMBER")
  assignedAt    DateTime  @default(now())
  removedAt     DateTime?
  assignedById  String
  removedById   String?
  removalReason String?
  isActive      Boolean   @default(true)
  compensationAmount Float?
  currency      String    @default("INR")
  removedBy     User?     @relation("MembershipRemover", fields: [removedById], references: [id])
  assignedBy    User      @relation("MembershipAssigner", fields: [assignedById], references: [id])
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectStage {
  id                 String             @id @default(uuid())
  projectId          String
  name               String
  orderIndex         Int                @default(1)
  weight             Float              @default(10)
  progressPercentage Float              @default(0)
  status             String             @default("PENDING")
  createdAt          DateTime           @default(now())
  checklists         ProjectChecklist[]
  project            Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks              Task[]
}

model ProjectChecklist {
  id               String       @id @default(uuid())
  stageId          String
  title            String
  description      String?
  status           String       @default("PENDING")
  assignedToId     String?
  startedAt        DateTime?
  completedAt      DateTime?
  completedById    String?
  estimatedMinutes Int          @default(60)
  actualMinutes    Int          @default(0)
  weight           Float        @default(1)
  required         Boolean      @default(true)
  requiresApproval Boolean      @default(false)
  approvedById     String?
  approvedAt       DateTime?
  notes            String?
  createdAt        DateTime     @default(now())
  completedBy      User?        @relation("ChecklistCompleter", fields: [completedById], references: [id])
  assignedTo       User?        @relation("ChecklistAssignee", fields: [assignedToId], references: [id])
  stage            ProjectStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
}

model Task {
  id             String        @id @default(uuid())
  projectId      String
  stageId        String?
  title          String
  description    String?
  assignedToId   String?
  createdById    String
  priority       String        @default("MEDIUM")
  status         String        @default("TODO")
  orderInt       Int           @default(0)
  completedAt    DateTime?
  startDate      DateTime?
  deadline       DateTime?
  estimatedHours Float         @default(0)
  actualHours    Float         @default(0)
  isMostImportant Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdBy      User          @relation("TaskCreator", fields: [createdById], references: [id])
  assignedTo     User?         @relation("TaskAssignee", fields: [assignedToId], references: [id])
  stage          ProjectStage? @relation(fields: [stageId], references: [id])
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workSessions   WorkSession[]

  @@index([projectId])
  @@index([assignedToId])
  @@index([status])
  @@index([assignedToId, isMostImportant])
}

model ProjectDocument {
  id          String            @id @default(uuid())
  projectId   String
  title       String
  category    String            @default("GENERAL")
  content     String
  version     Int               @default(1)
  createdById String
  updatedById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  versions    DocumentVersion[]
  updatedBy   User              @relation("DocUpdater", fields: [updatedById], references: [id])
  createdBy   User              @relation("DocCreator", fields: [createdById], references: [id])
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model DocumentVersion {
  id           String          @id @default(uuid())
  documentId   String
  version      Int
  content      String
  changeReason String?
  updatedById  String
  createdAt    DateTime        @default(now())
  updatedBy    User            @relation(fields: [updatedById], references: [id])
  document     ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model ProjectNote {
  id         String   @id @default(uuid())
  projectId  String
  authorId   String
  content    String
  visibility String   @default("INTERNAL")
  createdAt  DateTime @default(now())
  author     User     @relation(fields: [authorId], references: [id])
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ClientDiscussion {
  id              String         @id @default(uuid())
  projectId       String
  clientContactId String?
  date            DateTime       @default(now())
  startTime       String?
  endTime         String?
  summary         String
  discussionText  String
  decisionsText   String?
  actionItemsText String?
  createdById     String
  createdAt       DateTime       @default(now())
  createdBy       User           @relation(fields: [createdById], references: [id])
  clientContact   ClientContact? @relation(fields: [clientContactId], references: [id])
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ChangeRequest {
  id                  String              @id @default(uuid())
  requestNumber       String              @unique
  projectId           String
  requestedBy         String
  source              String              @default("CLIENT")
  originalRequirement String
  requestedChange     String
  reason              String?
  technicalImpact     String?
  timelineImpactDays  Int                 @default(0)
  costImpactAmount    Float               @default(0)
  estimatedHours      Float               @default(0)
  status              String              @default("DRAFT")
  budgetIncreaseRequired Boolean          @default(false)
  isQuotaIncluded        Boolean          @default(true)
  requestSeqInt          Int              @default(1)
  approvedById        String?
  approvedAt          DateTime?
  createdAt           DateTime            @default(now())
  approvedBy          User?               @relation("ChangeApprover", fields: [approvedById], references: [id])
  project             Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items               ChangeRequestItem[]

  @@unique([projectId, requestSeqInt])
  @@index([projectId])
  @@index([status])
}

model ChangeRequestItem {
  id              String        @id @default(uuid())
  changeRequestId String
  title           String
  description     String?
  category        String        @default("GENERAL")
  status          String        @default("PENDING")
  createdAt       DateTime      @default(now())
  changeRequest   ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)

  @@index([changeRequestId])
}

model Employee {
  id                 String                @id @default(uuid())
  userId             String                @unique
  employeeIdCode     String                @unique
  joiningDate        DateTime              @default(now())
  status             String                @default("ACTIVE")
  salaryMonthly      Float                 @default(0)
  phone              String?               @default("")
  relative1Name      String?               @default("")
  relative1Relation  String?               @default("")
  relative1Phone     String?               @default("")
  relative2Name      String?               @default("")
  relative2Relation  String?               @default("")
  relative2Phone     String?               @default("")
  customTermsTitle   String?
  customTermsContent String?
  termsVersion       String?               @default("v1.0")
  termsAcceptedAt    DateTime?
  termsAccepted      Boolean               @default(false)
  reportingManagerId String?
  skillsJson         String?               @default("[]")
  sickLeaveTotal     Int                   @default(10)
  sickLeaveUsed      Float                 @default(0)
  casualLeaveTotal   Int                   @default(15)
  casualLeaveUsed    Float                 @default(0)
  paidLeaveTotal     Int                   @default(15)
  paidLeaveUsed      Float                 @default(0)
  targetWorkingHours Float                 @default(8.0)
  dailyTargetTitle   String?               @default("Tasks")
  dailyTargetCount   Float                 @default(0)
  dailyTargetUnit    String?               @default("units")
  dailyTargetNotes   String?               @default("")
  createdAt          DateTime              @default(now())
  attendances        Attendance[]
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  statusEvents       EmployeeStatusEvent[]
  memberships        ProjectMembership[]
  workSessions       WorkSession[]
  leaveRequests      LeaveRequest[]
  timeModificationRequests TimeModificationRequest[]
  dailyWorkLogs      EmployeeDailyWorkLog[]
}

model EmployeeDailyWorkLog {
  id            String    @id @default(uuid())
  employeeId    String
  date          DateTime  @default(now())
  targetTitle   String    @default("Daily Output")
  targetCount   Float     @default(0)
  achievedCount Float     @default(0)
  unit          String    @default("units")
  notes         String?   @default("")
  loggedById    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([employeeId, date])
}

model Attendance {
  id                    String    @id @default(uuid())
  employeeId            String
  date                  DateTime  @default(now())
  punchIn               DateTime
  punchOut              DateTime?
  status                String    @default("PRESENT")
  totalMinutes          Int?      @default(0)
  punchOutReason        String?
  punchOutRequestStatus String?
  punchOutRequestedAt   DateTime?
  punchOutApprovedById  String?
  employee              Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  timeModificationRequests TimeModificationRequest[]

  @@index([employeeId, date])
}

model TimeModificationRequest {
  id                 String      @id @default(uuid())
  employeeId         String
  attendanceId       String?
  targetDate         DateTime
  originalPunchIn    DateTime?
  originalPunchOut   DateTime?
  requestedPunchIn   DateTime
  requestedPunchOut  DateTime
  reason             String
  status             String      @default("PENDING")
  reviewedById       String?
  reviewedAt         DateTime?
  reviewNotes        String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  employee           Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendance         Attendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  reviewedBy         User?       @relation("TimeModificationReviewer", fields: [reviewedById], references: [id])

  @@index([employeeId, targetDate])
  @@index([status])
}

model EmployeeStatusEvent {
  id         String    @id @default(uuid())
  employeeId String
  statusType String    @default("WORKING")
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  notes      String?
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model WorkSession {
  id              String    @id @default(uuid())
  employeeId      String
  projectId       String?
  taskId          String?
  statusType      String    @default("WORKING")
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationMinutes Int       @default(0)
  notes           String?
  task            Task?     @relation(fields: [taskId], references: [id])
  project         Project?  @relation(fields: [projectId], references: [id])
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model PaymentMilestone {
  id                   String    @id @default(uuid())
  projectId            String
  title                String
  amount               Float
  dueDate              DateTime
  status               String    @default("UPCOMING")
  paidAmount           Float     @default(0)
  paidAt               DateTime?
  paymentMethod        String?
  transactionReference String?
  invoiceNumber        String?
  notes                String?
  createdAt            DateTime  @default(now())
  project              Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  projectId     String
  clientId      String
  issueDate     DateTime @default(now())
  dueDate       DateTime
  totalAmount   Float
  taxAmount     Float    @default(0)
  grandTotal    Float
  status        String   @default("UNPAID")
  itemsJson     String   @default("[]")
  createdAt     DateTime @default(now())
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([projectId])
  @@index([status])
}

model ClientPortalToken {
  id        String   @id @default(uuid())
  clientId  String
  projectId String
  token     String   @unique
  expiresAt DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ClientUpdate {
  id         String   @id @default(uuid())
  projectId  String
  title      String
  content    String
  visibility String   @default("CLIENT_VISIBLE")
  authorId   String
  createdAt  DateTime @default(now())
  author     User     @relation(fields: [authorId], references: [id])
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ActivityEvent {
  id           String   @id @default(uuid())
  eventType    String
  actorId      String
  entityType   String
  entityId     String
  projectId    String?
  clientId     String?
  metadataJson String?
  createdAt    DateTime @default(now())
  actor        User     @relation(fields: [actorId], references: [id])
}

model Notification {
  id          String   @id @default(uuid())
  recipientId String
  title       String
  message     String
  urgency     String   @default("MEDIUM")
  linkUrl     String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  recipient   User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
}

model UserPushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  device    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LeaveRequest {
  id              String   @id @default(uuid())
  employeeId      String
  leaveType       String   // SICK, CASUAL, PAID
  startDate       DateTime
  endDate         DateTime
  days            Float    @default(1)
  reason          String
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approvedBy      User?    @relation("LeaveApprover", fields: [approvedById], references: [id])

  @@index([employeeId])
  @@index([status])
}

model SystemSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

model Terms {
  id             String   @id @default(uuid())
  targetAudience String   // "EMPLOYEE" | "CLIENT"
  version        String   // e.g. "v1.0", "v1.1", "v2.0"
  title          String   @default("Terms and Conditions of Service")
  content        String
  isCurrent      Boolean  @default(false)
  isDraft        Boolean  @default(false)
  publishedAt    DateTime?
  publishedById  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  publishedBy    User?    @relation("TermsPublisher", fields: [publishedById], references: [id])
  acceptances    TermsAcceptanceLog[]

  @@index([targetAudience, isCurrent])
  @@index([targetAudience, version])
}

model TermsAcceptanceLog {
  id              String        @id @default(uuid())
  termsId         String?
  userId          String?
  clientContactId String?
  targetAudience  String        // "EMPLOYEE" | "CLIENT"
  termsVersion    String
  acceptedAt      DateTime      @default(now())
  ipAddress       String?
  terms           Terms?        @relation(fields: [termsId], references: [id])
  user            User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientContact   ClientContact? @relation(fields: [clientContactId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clientContactId])
}

model Holiday {
  id          String    @id @default(uuid())
  title       String
  date        DateTime
  endDate     DateTime?
  type        String    @default("PUBLIC") // PUBLIC, STATE, COMPANY, OPTIONAL, CUSTOM
  country     String?   @default("IN")
  state       String?   // null for All India / national, or specific state name e.g. "Gujarat"
  source      String    @default("GOOGLE") // GOOGLE, SYSTEM, ADMIN, MANUAL
  sourceId    String?
  description String?
  isActive    Boolean   @default(true)
  isOptional  Boolean   @default(false)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([date])
  @@index([country, date])
  @@index([state, date])
  @@index([type, date])
  @@index([isActive])
  @@unique([title, date])
}

model MediaFile {
  id              String   @id @default(uuid())
  driveFileId     String   @unique
  storageProvider String   @default("GOOGLE_DRIVE")
  fileName        String
  originalName    String
  mimeType        String
  fileSize        Int
  category        String   @default("GENERAL")
  entityType      String
  entityId        String
  uploadedById    String?
  leadId          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  uploadedBy      User?    @relation("UserUploadedMedia", fields: [uploadedById], references: [id])
  lead            Lead?    @relation("LeadMediaFiles", fields: [leadId], references: [id], onDelete: Cascade)
  chatAttachments ChatMessageAttachment[]

  @@index([entityType, entityId])
  @@index([uploadedById])
  @@index([leadId])
  @@index([category])
}

model Conversation {
  id           String   @id @default(uuid())
  type         String   @default("DIRECT") // DIRECT, GROUP, PROJECT, ANNOUNCEMENT
  name         String?
  projectId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project      Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     ChatMessage[]

  @@index([updatedAt])
  @@index([projectId])
}

model ConversationParticipant {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model ChatMessage {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  messageType    String    @default("TEXT") // TEXT, IMAGE, FILE, SYSTEM
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  conversation   Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User                    @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments    ChatMessageAttachment[]

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model ChatMessageAttachment {
  id        String   @id @default(uuid())
  messageId String
  mediaId   String

  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  media     MediaFile   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([messageId, mediaId])
}

model SalesNote {
  id          String   @id @default(uuid())
  userId      String
  title       String
  content     String   @default("")
  category    String   @default("GENERAL") // GENERAL, CALL_LOG, DEAL_DRAFT, REMINDER, CLIENT_PITCH
  tags        String   @default("[]")      // JSON array of strings
  isPinned    Boolean  @default(false)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@index([isPinned])
}

model PersonalBrandProfile {
  id                  String                   @id @default(uuid())
  clientId            String?
  clientName          String
  handle              String?                  @default("")
  avatarUrl           String?
  niche               String                   @default("General")
  professionalBio     String?                  @default("")
  brandPositioning    String?                  @default("")
  targetAudience      String?                  @default("")
  targetGeography     String?                  @default("")
  toneOfVoice         String?                  @default("")
  brandGuidelines     String?                  @default("")
  socialLinksJson     String?                  @default("{}")
  monthlyPackage      String?                  @default("")
  monthlyCommitments  String?                  @default("")
  brandAuditSummary   String?                  @default("")
  competitorTracking  String?                  @default("")
  monthlyGoalsKpis    String?                  @default("")
  status              String                   @default("ACTIVE") // ACTIVE, ONBOARDING, PAUSED, COMPLETED
  createdById         String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  client              Client?                  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  contentItems        PersonalBrandContent[]
  brandMetrics        PersonalBrandMetric[]
  meetingNotes        PersonalBrandMeeting[]
  clientFeedbacks     PersonalBrandFeedback[]

  @@index([clientId])
  @@index([status])
}

model PersonalBrandContent {
  id                   String               @id @default(uuid())
  profileId            String
  title                String
  hook                 String?              @default("")
  topic                String?              @default("")
  platform             String               @default("INSTAGRAM") // INSTAGRAM, LINKEDIN, YOUTUBE_SHORTS, TWITTER_X, YOUTUBE_LONG
  contentType          String               @default("REEL") // REEL, CAROUSEL, TEXT_POST, LONG_VIDEO, NEWSLETTER
  priority             String               @default("MEDIUM") // URGENT, HIGH, MEDIUM, LOW
  scriptText           String?              @default("")
  caption              String?              @default("")
  hashtags             String?              @default("")
  trendingReferenceUrl String?              @default("")
  productionStage      String               @default("IDEA") // IDEA, SCRIPTING, SCRIPT_APPROVED, SHOOTING, EDITING, DRAFT_REVIEW, REVISION, CLIENT_APPROVED, SCHEDULED, PUBLISHED
  scriptwriterId       String?
  videoEditorId        String?
  designerId           String?
  scheduledDate        DateTime?
  publishedUrl         String?
  clientApproved       Boolean              @default(false)
  clientFeedback       String?              @default("")
  approvalDeadline     DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  profile              PersonalBrandProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([productionStage])
  @@index([platform])
}

model PersonalBrandMetric {
  id                   String               @id @default(uuid())
  profileId            String
  month                Int
  year                 Int
  platform             String               @default("TOTAL") // TOTAL, INSTAGRAM, LINKEDIN, YOUTUBE, X
  totalFollowers       Int                  @default(0)
  followerGrowth       Int                  @default(0)
  totalReach           Int                  @default(0)
  totalImpressions     Int                  @default(0)
  engagementRate       Float                @default(0)
  profileVisits        Int                  @default(0)
  inquiriesGenerated   Int                  @default(0)
  topPerformingContent String?              @default("")
  monthlyReportNotes   String?              @default("")
  goalsVersusResults   String?              @default("")
  createdAt            DateTime             @default(now())

  profile              PersonalBrandProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([year, month])
}

model PersonalBrandMeeting {
  id              String               @id @default(uuid())
  profileId       String
  title           String
  meetingDate     DateTime             @default(now())
  agenda          String?              @default("")
  discussionNotes String               @default("")
  actionItems     String?              @default("")
  nextMeetingDate DateTime?
  createdAt       DateTime             @default(now())

  profile         PersonalBrandProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model PersonalBrandFeedback {
  id              String               @id @default(uuid())
  profileId       String
  contentId       String?
  requestedBy     String               @default("Client") // "Client", "Internal"
  feedbackText    String               @default("")
  changeRequested String?              @default("")
  deadline        DateTime?
  status          String               @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  profile         PersonalBrandProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([status])
}

// ==========================================
// EVENT MANAGEMENT DEPARTMENT MODELS
// ==========================================

model EventProject {
  id                 String               @id @default(uuid())
  title              String
  type               String               @default("CORPORATE") // CORPORATE, CONCERT, CONFERENCE, WEDDING, PRODUCT_LAUNCH, EXHIBITION, GALA, PRIVATE_PARTY, OTHER
  status             String               @default("PLANNING") // PLANNING, PREPARATION, LIVE, CLOSURE, COMPLETED, CANCELLED
  startDate          DateTime
  endDate            DateTime?
  venueName          String
  venueAddress       String?              @default("")
  clientId           String?
  clientName         String
  eventOwner         String               @default("Lead Producer")
  productionManager  String?              @default("")
  estimatedBudget    Float                @default(0)
  approvedBudget     Float                @default(0)
  quotationAmount    Float                @default(0)
  actualCost         Float                @default(0)
  priority           String               @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  riskLevel          String               @default("LOW") // LOW, MEDIUM, HIGH
  riskOverview       String?              @default("")
  blockersOverview   String?              @default("")
  notes              String?              @default("")
  closureSignOff     Boolean              @default(false)
  createdById        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  client             Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  timelineItems      EventTimelineItem[]
  runOfShows         EventRunOfShow[]
  crewMembers        EventCrewMember[]
  vendors            EventVendor[]
  budgetItems        EventBudgetItem[]
  marketingItems     EventMarketingItem[]
  guests             EventGuest[]
  incidents          EventIncident[]
  mediaItems         EventMediaItem[]
  closure            EventClosure?

  @@index([clientId])
  @@index([status])
  @@index([startDate])
}

model EventTimelineItem {
  id                 String               @id @default(uuid())
  eventId            String
  title              String
  type               String               @default("MILESTONE") // MILESTONE, PREPARATION_TASK, REHEARSAL, SETUP, DISMANTLE, CHECKLIST
  startTime          DateTime?
  endTime            DateTime?
  status             String               @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, BLOCKED
  dependencies       String?              @default("")
  assignedTo         String?              @default("")
  order              Int                  @default(0)
  notes              String?              @default("")
  createdAt          DateTime             @default(now())

  event              EventProject         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([type])
}

model EventRunOfShow {
  id                 String               @id @default(uuid())
  eventId            String
  timeSlot           String               // e.g. "10:00 AM - 10:30 AM"
  activity           String
  responsiblePerson  String?              @default("")
  department         String?              @default("Stage") // Stage, Audio/Visual, Lighting, Artists, F&B, Logistics
  stageLocation      String?              @default("Main Stage")
  status             String               @default("UPCOMING") // UPCOMING, LIVE_NOW, COMPLETED, DELAYED
  cueNotes           String?              @default("")
  order              Int                  @default(0)
  createdAt          DateTime             @default(now())

  event              EventProject         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([status])
}

model EventCrewMember {
  id                 String               @id @default(uuid())
  eventId            String
  name               String
  role               String               // Floor Manager, Sound Engineer, Stage Crew, Hospitality, Security, Registration
  department         String               @default("Production") // Production, Hospitality, Technical, Media, Security, Operations
  shiftStartTime     String?              @default("")
  shiftEndTime       String?              @default("")
  isBackup           Boolean              @default(false)
  isFreelancer       Boolean              @default(false)
  status             String               @default("SCHEDULED") // SCHEDULED, CHECKED_IN, ON_DUTY, HANDED_OVER, CHECKED_OUT, ABSENT
  checkInTime        DateTime?
  checkOutTime       DateTime?
  dutyHandoverNotes  String?              @default("")
  phone              String?              @default("")
  createdAt          DateTime             @default(now())

  event              EventProject         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([status])
}

model EventVendor {
  id                 String               @id @default(uuid())
  eventId            String
  vendorName         String
  category           String               @default("DECOR") // DECOR, PRODUCTION_SOUND_LIGHT, ARTIST_PERFORMER, PHOTOGRAPHY_CINEMA, CATERING_FB, VENUE, FABRICATION, SECURITY_TRANSPORT, OTHER
  contactPerson      String?              @default("")
  phone              String?              @default("")
  email              String?              @default("")
  quoteAmount        Float                @default(0)
  approvedAmount     Float                @default(0)
  advancePaid        Float                @default(0)
  balanceDue         Float                @default(0)
  paymentMilestones  String?              @default("") // e.g. "50% Advance, 50% Post-Event"
  deliverablesTracked String?             @default("")
  contractUrl        String?              @default("")
  escalationContact  String?              @default("")
  arrivalStatus      String               @default("EXPECTED") // EXPECTED, ARRIVED, DELAYED, NOT_REQUIRED
  createdAt          DateTime             @default(now())

  event              EventProject         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([category])
}

model EventBudgetItem {
  id                 String               @id @default(uuid())
  eventId            String
  category           String               @default("PRODUCTION") // VENUE, PRODUCTION, DECOR, ARTISTS, CATERING, MARKETING, LOGISTICS, PERMITS, MISC
  description        String
  estimatedCost      Float                @default(0)
  actualCost         Float                @default(0)
  advancePaid        Float                @default(0)
  balancePaid        Float                @default(0)
  status             String               @default("PENDING") // DRAFT, REQUESTED, APPROVED, REJECTED, PAID
  vendorName         String?              @default("")
  approvedBy         String?              @default("")
  createdAt          DateTime             @default(now())

  event              EventProject         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([category])
}

model EventMarketingItem {
  id                 String               @id @default(uuid())
  eventId            String
  title              String
  type               String               @default("POSTER") // POSTER, REEL, STORY, SPONSOR_CREATIVE, AD_CAMPAIGN, INFLUENCER, PRESS_RELEASE
  platform           String               @default("INSTAGRAM") // INSTAGRAM, LINKEDIN, YOUTUBE, FACEBOOK, PR_MEDIA, PRINT
  scheduledDate      DateTime?
  assignee           String?              @default("")
  approvalStatus     String               @default("DRAFT") // DRAFT, IN_REVIEW, APPROVED, REVISION
  publishingStatus   String               @default("PENDING") // PENDING, SCHEDULED, PUBLISHED
  campaignPerformance String?             @default("")
  creativeUrl        String?              @default("")
  createdAt          DateTime             @default(now())

  event              EventProject         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([publishingStatus])
}

model EventGuest {
  id                 String               @id @default(uuid())
  eventId            String
  name               String
  email              String?              @default("")
  phone              String?              @default("")
  category           String               @default("GENERAL") // VIP, DELEGATE, MEDIA, SPEAKER, SPONSOR, GENERAL
  accessRights       String?              @default("ALL_ACCESS") // ALL_ACCESS, BACKSTAGE, VIP_LOUNGE, GENERAL_ENTRY
  rsvpStatus         String               @default("PENDING") // PENDING, ATTENDING, DECLINED, TENTATIVE
  ticketCode         String?              @default("")
  passType           String               @default("REGULAR") // REGULAR, VIP, COMPLIMENTARY
  complimentaryApproved Boolean           @default(false)
  isCheckedIn        Boolean              @default(false)
  checkInTime        DateTime?
  notes              String?              @default("")
  createdAt          DateTime             @default(now())

  event              EventProject         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([isCheckedIn])
}

model EventIncident {
  id                 String               @id @default(uuid())
  eventId            String
  title              String
  description        String
  severity           String               @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status             String               @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  reportedBy         String?              @default("")
  owner              String?              @default("")
  escalationNotes    String?              @default("")
  resolvedAt         DateTime?
  createdAt          DateTime             @default(now())

  event              EventProject         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([status])
}

model EventMediaItem {
  id                 String               @id @default(uuid())
  eventId            String
  shotTitle          String
  coverageType       String               @default("PHOTO") // PHOTO, VIDEO, DRONE, LIVE_STREAM, INTERVIEW
  photographer       String?              @default("")
  videographer       String?              @default("")
  prioritySameDay    Boolean              @default(false)
  footageTransferred Boolean              @default(false)
  status             String               @default("PLANNED") // PLANNED, CAPTURED, IN_EDITING, READY_FOR_REVIEW, DELIVERED
  deliveryUrl        String?              @default("")
  createdAt          DateTime             @default(now())

  event              EventProject         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([status])
}

model EventClosure {
  id                 String               @id @default(uuid())
  eventId            String               @unique
  equipmentReconciled Boolean             @default(false)
  vendorPaymentsClosed Boolean            @default(false)
  budgetReconciled   Boolean              @default(false)
  clientFeedback     String?              @default("")
  clientRating       Int                  @default(5)
  lessonsLearned     String?              @default("")
  performanceReportSummary String?        @default("")
  eventArchiveUrl    String?              @default("")
  finalSignOffBy     String?              @default("")
  finalSignOffDate   DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  event              EventProject         @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model VideographerFootage {
  id               String    @id @default(uuid())
  videographerId   String
  videographerName String
  shootTitle       String
  driveUrl         String
  notes            String?   @default("")
  videosCount      Int       @default(0)
  photosCount      Int       @default(0)
  editorId         String?
  editorName       String?   @default("")
  status           String    @default("UPLOADED") // UPLOADED, IN_EDITING, COMPLETED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([videographerId])
  @@index([status])
}


